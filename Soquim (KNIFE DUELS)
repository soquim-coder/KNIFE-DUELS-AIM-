                    BackgroundColor3 = THEME.BG_ELEMENT,
                    BackgroundTransparency = 0.5,
                    TextColor3 = THEME.TEXT_MID,
                }):Play()
                TweenService:Create(t.stroke, TweenInfo.new(0.2), {
                    Color = THEME.STROKE_MID, Transparency = 0.6,
                }):Play()
            end
        end
    end

