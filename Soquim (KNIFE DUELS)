local function clearPostEffects()
    for _, v in ipairs(Lighting:GetChildren()) do
        if (v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("SunRaysEffect") or v:IsA("BlurEffect")) and v.Name:sub(1, 7) == "SOQUIM_" then
            v:Destroy()
        end
    end
end

local function applyShader(shaderName)
    clearPostEffects()
    Lighting.Ambient = originalLighting.Ambient
    Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
    Lighting.Brightness = originalLighting.Brightness
    Lighting.ExposureCompensation = originalLighting.ExposureCompensation
    Lighting.FogColor = originalLighting.FogColor
    Lighting.FogStart = originalLighting.FogStart
    Lighting.FogEnd = originalLighting.FogEnd

    if shaderName == "None" then return end

    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "SOQUIM_CC"
    cc.Parent = Lighting

    if shaderName == "Cinematic" then
        cc.Brightness = -0.05; cc.Contrast = 0.25; cc.Saturation = 0.1
        cc.TintColor = Color3.fromRGB(255, 240, 220)
        Lighting.Ambient = Color3.fromRGB(60, 60, 70); Lighting.Brightness = 2
        local bloom = Instance.new("BloomEffect"); bloom.Name = "SOQUIM_Bloom"
        bloom.Intensity = 0.6; bloom.Size = 18; bloom.Threshold = 1.2; bloom.Parent = Lighting
    elseif shaderName == "Vibrant" then
        cc.Saturation = 0.6; cc.Contrast = 0.15; cc.Brightness = 0.05; Lighting.Brightness = 3
    elseif shaderName == "Cold" then
        cc.TintColor = Color3.fromRGB(180, 210, 255); cc.Saturation = -0.1; cc.Contrast = 0.15; cc.Brightness = -0.03
    elseif shaderName == "Warm" then
        cc.TintColor = Color3.fromRGB(255, 200, 150); cc.Saturation = 0.2; cc.Contrast = 0.1; cc.Brightness = 0.05
    elseif shaderName == "Noir" then
        cc.Saturation = -1; cc.Contrast = 0.4; cc.Brightness = -0.08; cc.TintColor = Color3.fromRGB(230, 230, 230)
    elseif shaderName == "Neon" then
        cc.Saturation = 0.9; cc.Contrast = 0.35; cc.Brightness = 0.08; cc.TintColor = Color3.fromRGB(200, 180, 255)
        local bloom = Instance.new("BloomEffect"); bloom.Name = "SOQUIM_Bloom"
        bloom.Intensity = 1.2; bloom.Size = 24; bloom.Threshold = 0.9; bloom.Parent = Lighting
    elseif shaderName == "Retro" then
        cc.Saturation = -0.3; cc.Contrast = 0.2; cc.TintColor = Color3.fromRGB(255, 230, 200); cc.Brightness = -0.05
        Lighting.FogColor = Color3.fromRGB(120, 100, 80); Lighting.FogStart = 50; Lighting.FogEnd = 300
    elseif shaderName == "Dreamy" then
        cc.Saturation = 0.3; cc.Contrast = -0.1; cc.Brightness = 0.1; cc.TintColor = Color3.fromRGB(255, 220, 240)
        local bloom = Instance.new("BloomEffect"); bloom.Name = "SOQUIM_Bloom"
        bloom.Intensity = 0.8; bloom.Size = 30; bloom.Threshold = 1.0; bloom.Parent = Lighting
        local blur = Instance.new("BlurEffect"); blur.Name = "SOQUIM_Blur"
        blur.Size = 2; blur.Parent = Lighting
    end
end

