local crosshairRoot = Instance.new("Frame")
crosshairRoot.Name = "Crosshair"
crosshairRoot.AnchorPoint = Vector2.new(0.5, 0.5)
crosshairRoot.Position = UDim2.new(0.5, 0, 0.5, 0)
crosshairRoot.Size = UDim2.new(0, 0, 0, 0)
crosshairRoot.BackgroundTransparency = 1
crosshairRoot.Visible = false
crosshairRoot.Parent = uiLayerGui

local crosshairParts = {}

local function clearCrosshair()
    for _, p in ipairs(crosshairParts) do p:Destroy() end
    crosshairParts = {}
end

local function addCrosshairPart(size, pos, anchor, isRound)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(0, size.X, 0, size.Y)
    f.Position = UDim2.new(0.5, pos.X, 0.5, pos.Y)
    f.AnchorPoint = anchor
    f.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    f.BorderSizePixel = 0
    f.Parent = crosshairRoot
    if isRound then
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
    end
    table.insert(crosshairParts, f)
    return f
end

local function applyCrosshair(style)
    clearCrosshair()
    if style == "None" then
        crosshairRoot.Visible = false
        return
    end
    crosshairRoot.Visible = true

    if style == "Dot" then
        addCrosshairPart(Vector2.new(4, 4), Vector2.new(0, 0), Vector2.new(0.5, 0.5), true)
    elseif style == "Cross" then
        addCrosshairPart(Vector2.new(2, 12), Vector2.new(0, 0), Vector2.new(0.5, 0.5), false)
        addCrosshairPart(Vector2.new(12, 2), Vector2.new(0, 0), Vector2.new(0.5, 0.5), false)
    elseif style == "Circle" then
        local c = Instance.new("Frame")
        c.Size = UDim2.new(0, 14, 0, 14)
        c.Position = UDim2.new(0.5, 0, 0.5, 0)
        c.AnchorPoint = Vector2.new(0.5, 0.5)
        c.BackgroundTransparency = 1
        c.Parent = crosshairRoot
        local st = Instance.new("UIStroke")
        st.Color = Color3.fromRGB(255, 255, 255); st.Thickness = 1.5; st.Parent = c
        Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
        table.insert(crosshairParts, c)
    elseif style == "Dot + Circle" then
        addCrosshairPart(Vector2.new(3, 3), Vector2.new(0, 0), Vector2.new(0.5, 0.5), true)
        local c = Instance.new("Frame")
        c.Size = UDim2.new(0, 16, 0, 16)
        c.Position = UDim2.new(0.5, 0, 0.5, 0)
        c.AnchorPoint = Vector2.new(0.5, 0.5)
        c.BackgroundTransparency = 1
        c.Parent = crosshairRoot
        local st = Instance.new("UIStroke")
        st.Color = Color3.fromRGB(255, 255, 255); st.Thickness = 1.5; st.Parent = c
        Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
        table.insert(crosshairParts, c)
    elseif style == "T-Style" then
        addCrosshairPart(Vector2.new(2, 8), Vector2.new(0, -6), Vector2.new(0.5, 0.5), false)
        addCrosshairPart(Vector2.new(2, 8), Vector2.new(0, 6), Vector2.new(0.5, 0.5), false)
        addCrosshairPart(Vector2.new(8, 2), Vector2.new(-6, 0), Vector2.new(0.5, 0.5), false)
        addCrosshairPart(Vector2.new(8, 2), Vector2.new(6, 0), Vector2.new(0.5, 0.5), false)
    end
end

local function setCrosshairColor(colorName)
    local color = COLOR_PRESETS[colorName] or Color3.fromRGB(255, 255, 255)
    for _, p in ipairs(crosshairParts) do
        if p:IsA("Frame") then
            if p.BackgroundTransparency < 1 then
                p.BackgroundColor3 = color
            end
            local st = p:FindFirstChildOfClass("UIStroke")
            if st then st.Color = color end
        end
    end
end

