                currentValue.Text = "Selected: " .. opt
                for name2, info in pairs(btnList) do
                    if name2 == opt then
                        TweenService:Create(info.btn, TweenInfo.new(0.2), {
                            BackgroundColor3 = THEME.ACTIVE, BackgroundTransparency = 0,
                            TextColor3 = Color3.fromRGB(25, 25, 30),
                        }):Play()
                        TweenService:Create(info.stroke, TweenInfo.new(0.2), { Color = THEME.WHITE, Transparency = 0.3 }):Play()
                    else
                        TweenService:Create(info.btn, TweenInfo.new(0.2), {
                            BackgroundColor3 = THEME.BG_ELEMENT_2, BackgroundTransparency = 0.3,
                            TextColor3 = THEME.TEXT_MID,
                        }):Play()
                        TweenService:Create(info.stroke, TweenInfo.new(0.2), { Color = THEME.STROKE_MID, Transparency = 0.6 }):Play()
                    end
                end
                if onSelect then onSelect(opt) end
            end)
        end

        if btnList["None"] then
            local info = btnList["None"]
            info.btn.BackgroundColor3 = THEME.ACTIVE
            info.btn.BackgroundTransparency = 0
            info.btn.TextColor3 = Color3.fromRGB(25, 25, 30)
            info.stroke.Color = THEME.WHITE
            info.stroke.Transparency = 0.3
            currentValue.Text = "Selected: None"
        end

        return wrap
    end

