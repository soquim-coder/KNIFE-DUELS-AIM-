-- =========================================
local Optimization = {
    originalQuality = nil, originalGlobalShadows = nil, originalAmbient = nil,
    originalOutdoorAmbient = nil, originalBrightness = nil, originalClockTime = nil,
    originalFogEnd = nil, originalShadowSoftness = nil, removedInstances = {},
}

local function saveOriginalSettings()
    if Optimization.originalQuality then return end
    pcall(function() Optimization.originalQuality = settings().Rendering.QualityLevel end)
    Optimization.originalGlobalShadows = Lighting.GlobalShadows
    Optimization.originalAmbient = Lighting.Ambient
    Optimization.originalOutdoorAmbient = Lighting.OutdoorAmbient
    Optimization.originalBrightness = Lighting.Brightness
    Optimization.originalClockTime = Lighting.ClockTime
    Optimization.originalFogEnd = Lighting.FogEnd
    Optimization.originalShadowSoftness = Lighting.ShadowSoftness
end

local function removeTextures()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            pcall(function() obj.Transparency = 1; obj.Visible = false end)
        elseif obj:IsA("SurfaceAppearance") then
            pcall(function() obj.AlphaMode = Enum.AlphaMode.Overlay end)
        end
    end
end

local function restoreTextures()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") then
            pcall(function() obj.Transparency = 0; obj.Visible = true end)
        end
    end
end

local function removeAccessories(plr)
    local targets = plr and {plr} or Players:GetPlayers()
    for _, p in ipairs(targets) do
        if p.Character then
            for _, item in ipairs(p.Character:GetChildren()) do
                if item:IsA("Accessory") or item:IsA("Hat") then
                    pcall(function() item:Destroy() end)
                end
            end
        end
    end
end

local function removeEffects()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
            pcall(function() obj.Enabled = false end)
        end
    end
end

local function restoreEffects()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")
            or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            pcall(function() obj.Enabled = true end)
        end
    end
end

local function removeNames()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function()
                    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
                    hum.NameDisplayDistance = 0; hum.HealthDisplayDistance = 0
                end)
            end
        end
    end
end

local function restoreNames()
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function()
                    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
                    hum.NameDisplayDistance = 100; hum.HealthDisplayDistance = 100
                end)
            end
        end
    end
end

local function applyLowDetail()
    saveOriginalSettings()
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    Lighting.GlobalShadows = false; Lighting.ShadowSoftness = 0
end

local function restoreLowDetail()
    pcall(function()
        if Optimization.originalQuality then settings().Rendering.QualityLevel = Optimization.originalQuality
        else settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end
    end)
    if Optimization.originalGlobalShadows ~= nil then Lighting.GlobalShadows = Optimization.originalGlobalShadows end
    if Optimization.originalShadowSoftness ~= nil then Lighting.ShadowSoftness = Optimization.originalShadowSoftness end
end

local function applyPotatoMode()
    saveOriginalSettings()
    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
    Lighting.GlobalShadows = false; Lighting.ShadowSoftness = 0
    Lighting.Brightness = 0.5
    Lighting.Ambient = Color3.fromRGB(120, 120, 120)
    Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
    Lighting.FogEnd = 100000
    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") then
            pcall(function() v.Enabled = false; Optimization.removedInstances[v] = true end)
        end
    end
    removeTextures(); removeAccessories(); removeEffects(); removeNames()
end

local function restorePotatoMode()
    pcall(function()
        if Optimization.originalQuality then settings().Rendering.QualityLevel = Optimization.originalQuality
        else settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end
    end)
    if Optimization.originalGlobalShadows ~= nil then Lighting.GlobalShadows = Optimization.originalGlobalShadows end
    if Optimization.originalShadowSoftness ~= nil then Lighting.ShadowSoftness = Optimization.originalShadowSoftness end
    if Optimization.originalAmbient then Lighting.Ambient = Optimization.originalAmbient end
    if Optimization.originalOutdoorAmbient then Lighting.OutdoorAmbient = Optimization.originalOutdoorAmbient end
    if Optimization.originalBrightness then Lighting.Brightness = Optimization.originalBrightness end
    if Optimization.originalFogEnd then Lighting.FogEnd = Optimization.originalFogEnd end
    for v in pairs(Optimization.removedInstances) do
        pcall(function() if v and v.Parent then v.Enabled = true end end)
    end
    Optimization.removedInstances = {}
    restoreTextures(); restoreEffects(); restoreNames()
end

local function applyOptimization(name, enabled)
    if name == "Remove Textures" then
        if enabled then removeTextures() else restoreTextures() end
    elseif name == "Remove Accessories" then
        if enabled then removeAccessories() end
    elseif name == "Remove Effects" then
        if enabled then removeEffects() else restoreEffects() end
    elseif name == "Remove Names" then
        if enabled then removeNames() else restoreNames() end
    elseif name == "Low Detail" then
        if enabled then applyLowDetail() else restoreLowDetail() end
    elseif name == "Potato Mode" then
        if enabled then applyPotatoMode() else restorePotatoMode() end
    end
end

