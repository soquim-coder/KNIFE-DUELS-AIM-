    local function switchTab(name)
        currentPage = name
        for pageName, page in pairs(pages) do
            page.Visible = (pageName == name)
        end

        local tabList = {
            { name = "Main", btn = mainTab, stroke = mainStroke },
            { name = "ESP", btn = espTab, stroke = espStroke },
            { name = "Visual", btn = visualTab, stroke = visualStroke },
            { name = "Interface", btn = interfaceTab, stroke = interfaceStroke },
            { name = "Autofarm", btn = autofarmTab, stroke = autofarmStroke },
        }
        for _, t in ipairs(tabList) do
            if t.name == name then
                TweenService:Create(t.btn, TweenInfo.new(0.2), {
                    BackgroundColor3 = THEME.ACTIVE,
                    BackgroundTransparency = 0,
                    TextColor3 = Color3.fromRGB(25, 25, 30),
                }):Play()
                TweenService:Create(t.stroke, TweenInfo.new(0.2), {
                    Color = THEME.WHITE, Transparency = 0.3,
                }):Play()
            else
