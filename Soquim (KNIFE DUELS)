local function removeEspForPlayer(plr)
    local data = espData[plr]
    if not data then return end
    if data.box then data.box:Destroy() end
    if data.dot then data.dot:Destroy() end
    if data.tracer then data.tracer:Destroy() end
    if data.nameLabel then data.nameLabel:Destroy() end
    if data.healthBg then data.healthBg:Destroy() end
    if data.distLabel then data.distLabel:Destroy() end
    if data.highlight then data.highlight:Destroy() end
    if data.cube then data.cube:Destroy() end
    if data.skeletonLines then
        for _, l in ipairs(data.skeletonLines) do
            if l then l:Destroy() end
        end
    end
    espData[plr] = nil
end

RunService.RenderStepped:Connect(function()
    for plr, data in pairs(espData) do
        if plr == LocalPlayer or not plr.Parent then
            removeEspForPlayer(plr)
            continue
        end

        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        local shouldHide = false
        if not char or not head or not hrp or not humanoid or humanoid.Health <= 0 then
            shouldHide = true
        end
        if CONFIG.TEAM_CHECK and LocalPlayer.Team and plr.Team and LocalPlayer.Team == plr.Team then
            shouldHide = true
        end

        if shouldHide then
            data.box.Visible = false
            data.dot.Visible = false
            data.tracer.Visible = false
            data.nameLabel.Visible = false
            data.healthBg.Visible = false
            data.distLabel.Visible = false
            data.cube.Visible = false
            data.highlight.Adornee = nil
            data.highlight.OutlineTransparency = 1
            data.highlight.FillTransparency = 1
            for _, l in ipairs(data.skeletonLines) do l.Visible = false end
            continue
        end

        local headPos, headOnScreen = Camera:WorldToViewportPoint(head.Position)
        if not headOnScreen then
            data.box.Visible = false
            data.dot.Visible = false
            data.tracer.Visible = false
            data.nameLabel.Visible = false
            data.healthBg.Visible = false
            data.distLabel.Visible = false
            data.cube.Visible = false
            data.highlight.Adornee = nil
            data.highlight.OutlineTransparency = 1
            data.highlight.FillTransparency = 1
            for _, l in ipairs(data.skeletonLines) do l.Visible = false end
            continue
        end

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
        rayParams.IgnoreWater = true
        local origin = Camera.CFrame.Position
        local dir = head.Position - origin
        local rayResult = Workspace:Raycast(origin, dir, rayParams)
        local visible = true
        if rayResult and not rayResult.Instance:IsDescendantOf(char) then
            visible = false
        end

        local headScreen = Vector2.new(headPos.X, headPos.Y)
        local hrpPos = Camera:WorldToViewportPoint(hrp.Position)
        local hrpScreen = Vector2.new(hrpPos.X, hrpPos.Y)

        local topY = headScreen.Y - 30
        local bottomY = hrpScreen.Y + 30
        local boxHeight = bottomY - topY
        local boxWidth = boxHeight * 0.55
        local boxLeft = headScreen.X - boxWidth / 2
        local boxTop = topY

        if ESP_SETTINGS.Box then
            data.box.Visible = true
            data.box.Position = UDim2.new(0, boxLeft, 0, boxTop)
            data.box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
            data.box.UIStroke.Transparency = visible and 0.2 or 0.7
        else
            data.box.Visible = false
        end

        if ESP_SETTINGS.Cube then
            data.cube.Visible = true
            local cubeWidth = boxWidth * 1.1
            local cubeHeight = boxHeight * 1.05
            data.cube.Position = UDim2.new(0, headScreen.X - cubeWidth / 2, 0, topY - 8)
            data.cube.Size = UDim2.new(0, cubeWidth, 0, cubeHeight)
            data.cube.UIStroke.Transparency = visible and 0.15 or 0.6
            data.cube.BackgroundTransparency = visible and 0.95 or 0.98
        else
            data.cube.Visible = false
        end

        if ESP_SETTINGS.Dot then
            data.dot.Visible = true
            data.dot.Position = UDim2.new(0, headScreen.X, 0, topY - 14)
            data.dot.BackgroundTransparency = visible and 0 or 0.5
        else
            data.dot.Visible = false
        end

        if ESP_SETTINGS.Name then
            data.nameLabel.Visible = true
            data.nameLabel.Text = plr.Name
            data.nameLabel.Position = UDim2.new(0, headScreen.X, 0, topY - 32)
            data.nameLabel.AnchorPoint = Vector2.new(0.5, 0.5)
            data.nameLabel.TextTransparency = visible and 0 or 0.4
            data.nameLabel.TextStrokeTransparency = visible and 0 or 0.6
        else
            data.nameLabel.Visible = false
        end

        if ESP_SETTINGS.Distance then
            data.distLabel.Visible = true
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            data.distLabel.Text = math.floor(dist) .. "m"
            data.distLabel.Position = UDim2.new(0, headScreen.X, 0, bottomY + 12)
            data.distLabel.AnchorPoint = Vector2.new(0.5, 0.5)
            data.distLabel.TextTransparency = visible and 0 or 0.4
            data.distLabel.TextStrokeTransparency = visible and 0 or 0.6
        else
            data.distLabel.Visible = false
        end

        if ESP_SETTINGS.Health then
            data.healthBg.Visible = true
            data.healthBg.Position = UDim2.new(0, boxLeft - 8, 0, boxTop)
            data.healthBg.Size = UDim2.new(0, 3, 0, boxHeight)
            local hp = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
            data.healthFill.Size = UDim2.new(1, 0, hp, 0)
            data.healthFill.BackgroundTransparency = visible and 0 or 0.5
            data.healthBg.BackgroundTransparency = visible and 0 or 0.5
        else
            data.healthBg.Visible = false
        end

        if ESP_SETTINGS.Tracer then
            data.tracer.Visible = true
            local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            local endPoint = Vector2.new(headScreen.X, hrpScreen.Y + 30)
            local delta = endPoint - screenBottom
            local len = delta.Magnitude
            data.tracer.Position = UDim2.new(0, (screenBottom.X + endPoint.X) / 2, 0, (screenBottom.Y + endPoint.Y) / 2)
            data.tracer.Size = UDim2.new(0, len, 0, 1.5)
            data.tracer.Rotation = math.deg(math.atan2(delta.Y, delta.X))
            data.tracer.BackgroundTransparency = visible and 0.2 or 0.7
        else
            data.tracer.Visible = false
        end

        if ESP_SETTINGS.Outline then
            data.highlight.Adornee = char
            data.highlight.FillTransparency = 1
            data.highlight.OutlineTransparency = visible and 0.2 or 0.7
            data.highlight.FillColor = ESP_COLOR
            data.highlight.OutlineColor = ESP_COLOR
        else
            data.highlight.Adornee = nil
            data.highlight.OutlineTransparency = 1
            data.highlight.FillTransparency = 1
        end

        if ESP_SETTINGS.Skeleton then
            local partPositions = {}
            for _, partName in ipairs(data.skeletonParts) do
                local part = char:FindFirstChild(partName)
                if part and part:IsA("BasePart") then
                    local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        partPositions[partName] = Vector2.new(sp.X, sp.Y)
                    end
                end
            end

            local bones = {
                {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
                {"UpperTorso", "LeftUpperArm"}, {"LeftUpperArm", "LeftLowerArm"},
                {"LeftLowerArm", "LeftHand"}, {"UpperTorso", "RightUpperArm"},
                {"RightUpperArm", "RightLowerArm"}, {"RightLowerArm", "RightHand"},
                {"LowerTorso", "LeftUpperLeg"}, {"LeftUpperLeg", "LeftLowerLeg"},
                {"LeftLowerLeg", "LeftFoot"}, {"LowerTorso", "RightUpperLeg"},
                {"RightUpperLeg", "RightLowerLeg"}, {"RightLowerLeg", "RightFoot"},
            }

            for i, line in ipairs(data.skeletonLines) do
                local bone = bones[i]
                if bone and partPositions[bone[1]] and partPositions[bone[2]] then
                    line.Visible = true
                    drawLine(line, partPositions[bone[1]], partPositions[bone[2]], 1.5)
                    line.BackgroundTransparency = visible and 0.15 or 0.7
                else
                    line.Visible = false
                end
            end
        else
            for _, l in ipairs(data.skeletonLines) do l.Visible = false end
        end
    end
end)

