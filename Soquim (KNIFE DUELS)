local function createGithubLogo(parent, size)
    local logo = Instance.new("Frame")
    logo.Size = UDim2.new(0, size, 0, size)
    logo.BackgroundTransparency = 1
    logo.Parent = parent

    local function part(pos, sz)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(sz, 0, sz, 0)
        f.Position = UDim2.new(pos.X, 0, pos.Y, 0)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = THEME.WHITE
        f.BorderSizePixel = 0
        f.Parent = logo
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
