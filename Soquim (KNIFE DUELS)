local function setKeyActive(name, isActive)
    local data = keyFrames[name]
    if not data then return end
    if data.active == isActive then return end
    data.active = isActive
    if isActive then
        data.frame.BackgroundColor3 = THEME.ACTIVE
        data.frame.BackgroundTransparency = 0
        data.label.TextColor3 = Color3.fromRGB(20, 20, 24)
        data.stroke.Color = THEME.WHITE
        data.stroke.Transparency = 0
    else
        data.frame.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
        data.frame.BackgroundTransparency = 0.35
        data.label.TextColor3 = Color3.fromRGB(230, 230, 235)
        data.stroke.Color = Color3.fromRGB(60, 60, 70)
        data.stroke.Transparency = 0.5
    end
end

