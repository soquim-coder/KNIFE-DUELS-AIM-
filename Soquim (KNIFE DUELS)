local fovCircleState = { active = false, currentFov = 0, targetFov = 0 }

local function showFovCircle(fov, color, thickness, transparency)
    fovCircleState.targetFov = fov
    fovCircleState.active = true
    fovCircle.Visible = true
    TweenService:Create(fovStroke, TweenInfo.new(0.25), { Color = color, Thickness = thickness, Transparency = transparency }):Play()
    for _, m in ipairs(markers) do
        TweenService:Create(m, TweenInfo.new(0.25), { BackgroundColor3 = color, BackgroundTransparency = transparency + 0.15 }):Play()
    end
    TweenService:Create(centerDot, TweenInfo.new(0.25), { BackgroundColor3 = color, BackgroundTransparency = transparency + 0.1 }):Play()
end

local function hideFovCircle()
    fovCircleState.active = false
    fovCircleState.targetFov = 0
    TweenService:Create(fovStroke, TweenInfo.new(0.25), { Transparency = 1 }):Play()
    for _, m in ipairs(markers) do TweenService:Create(m, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play() end
    TweenService:Create(centerDot, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
    task.delay(0.3, function() if not fovCircleState.active then fovCircle.Visible = false end end)
end

RunService.RenderStepped:Connect(function(dt)
    if not fovCircle.Visible then return end
    local diff = fovCircleState.targetFov - fovCircleState.currentFov
    if math.abs(diff) > 0.5 then
        fovCircleState.currentFov = fovCircleState.currentFov + diff * math.min(dt * 12, 1)
    else
        fovCircleState.currentFov = fovCircleState.targetFov
    end
    local size = fovCircleState.currentFov * 2
    fovCircle.Size = UDim2.new(0, size, 0, size)
end)

