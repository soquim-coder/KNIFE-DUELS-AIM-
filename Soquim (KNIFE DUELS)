local playerColorConnection = nil

local function setBodyColor(color)
    local char = LocalPlayer.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Color = color
        end
    end
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Shirt") or item:IsA("Pants") or item:IsA("ShirtGraphic") or item:IsA("Accessory") then
            item:Destroy()
        end
    end
end

local function applyPlayerColor(colorName)
    if playerColorConnection then
        playerColorConnection:Disconnect()
        playerColorConnection = nil
    end

    if colorName == "None" then return end

    if colorName == "Rainbow" then
        playerColorConnection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hue = (tick() * 0.3) % 1
            local color = Color3.fromHSV(hue, 0.8, 1)
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Color = color
                end
            end
        end)
        setBodyColor(Color3.fromRGB(255, 255, 255))
    else
        local color = COLOR_PRESETS[colorName]
        if not color then return end
        setBodyColor(color)
        playerColorConnection = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(0.3)
            setBodyColor(color)
        end)
    end
end

