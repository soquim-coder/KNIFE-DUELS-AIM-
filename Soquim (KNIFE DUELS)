--           AIM ASSIST + TRIGGER + WALLCHECK
-- =========================================
local aiming = false
local triggering = false
local currentTarget = nil

local cache = {
    target = nil,
    head = nil,
    lastSearch = 0,
    lastVelocityUpdate = 0,
    lastTargetChange = 0,
    cachedVelocity = Vector3.zero,
    smoothedVelocity = Vector3.zero,
    smoothedPosition = nil,
    cachedCharacter = nil,
}

