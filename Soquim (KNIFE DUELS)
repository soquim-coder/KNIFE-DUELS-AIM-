UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == CONFIG.AIM_KEY then
        aiming = true
        cache.lastSearch = 0; cache.lastVelocityUpdate = 0; cache.lastTargetChange = 0
        cache.smoothedPosition = nil; cache.smoothedVelocity = Vector3.zero
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        triggering = true
        cache.lastSearch = 0; cache.lastVelocityUpdate = 0; cache.lastTargetChange = 0
        cache.target = nil; cache.head = nil; cache.smoothedPosition = nil; cache.smoothedVelocity = Vector3.zero
    end
    local kName = keyMap[input.KeyCode]
    if kName then setKeyActive(kName, true) end
    if input.KeyCode == CONFIG.MENU_KEY and not gameProcessed then
        if _toggleMenuFunc then _toggleMenuFunc() end
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == CONFIG.AIM_KEY then
        aiming = false
        if not MODULES.Aimbot and not MODULES.AimbotV2 and not MODULES.Trigger then
            currentTarget = nil; cache.target = nil; cache.head = nil
            cache.smoothedPosition = nil; cache.smoothedVelocity = Vector3.zero
        end
    end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        triggering = false
        if not MODULES.Aimbot and not MODULES.AimbotV2 and not MODULES.Aim and not MODULES.Trigger then
            currentTarget = nil; cache.target = nil; cache.head = nil
            cache.smoothedPosition = nil; cache.smoothedVelocity = Vector3.zero
        end
    end
    local kName = keyMap[input.KeyCode]
    if kName then setKeyActive(kName, false) end
end)

