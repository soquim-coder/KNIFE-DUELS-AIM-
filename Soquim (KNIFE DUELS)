local autofarmState = {
    currentIndex = 1,
    lastTeleport = 0,
    lastRandom = 0,
    lastCharacter = nil,
}

local function getPlayersList()
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                table.insert(list, plr)
            end
        end
    end
    return list
end

local function teleportToPlayer(plr, heightOffset)
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local targetChar = plr.Character
    local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
    if not myHrp or not targetHrp then return false end

    local offset = Vector3.new(0, heightOffset or AUTOFARM_SETTINGS.TELEPORT_HEIGHT, 0)
    myHrp.CFrame = CFrame.new(targetHrp.Position + offset)
    myHrp.AssemblyLinearVelocity = Vector3.zero
    return true
end

local function teleportToPosition(pos, heightOffset)
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end

    local offset = Vector3.new(0, heightOffset or AUTOFARM_SETTINGS.TELEPORT_HEIGHT, 0)
    myHrp.CFrame = CFrame.new(pos + offset)
    myHrp.AssemblyLinearVelocity = Vector3.zero
    return true
end

local function runTPFarm(now)
    if now - autofarmState.lastTeleport < AUTOFARM_SETTINGS.TP_DELAY then return end
    autofarmState.lastTeleport = now

    local list = getPlayersList()
    if #list == 0 then return end

    autofarmState.currentIndex = autofarmState.currentIndex + 1
    if autofarmState.currentIndex > #list then
        autofarmState.currentIndex = 1
    end

    local target = list[autofarmState.currentIndex]
    if target then
        teleportToPlayer(target)
    end
end

local function runTPFarmRandom(now)
    if now - autofarmState.lastRandom < AUTOFARM_SETTINGS.RANDOM_DELAY then return end
    autofarmState.lastRandom = now

    local list = getPlayersList()
    if #list == 0 then return end

    local target = list[math.random(1, #list)]
    if target then
        teleportToPlayer(target)
    end
end

local spinAngle = 0
local function runSpinFarm(now, dt)
    spinAngle = spinAngle + dt * AUTOFARM_SETTINGS.SPIN_SPEED
    local myChar = LocalPlayer.Character
    if not myChar then return end

    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    Camera.CFrame = CFrame.new(Camera.CFrame.Position) * CFrame.Angles(0, math.rad(AUTOFARM_SETTINGS.SPIN_SPEED * 60 * dt), 0)

    if now - autofarmState.lastTeleport < 0.5 then return end
    autofarmState.lastTeleport = now

    local list = getPlayersList()
    if #list == 0 then return end
    local target = list[math.random(1, #list)]
    if target then
        teleportToPlayer(target)
    end
end

local function runNearestFarm(now)
    if now - autofarmState.lastTeleport < 0.3 then return end
    autofarmState.lastTeleport = now

    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end

    local list = getPlayersList()
    if #list == 0 then return end

    local closest = nil
    local closestDist = math.huge
    for _, plr in ipairs(list) do
        local targetHrp = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if targetHrp then
            local d = (targetHrp.Position - myHrp.Position).Magnitude
            if d < closestDist then
                closestDist = d
                closest = targetHrp
            end
        end
    end

    if closest then
        teleportToPosition(closest.Position)
    end
end

RunService.Heartbeat:Connect(function(dt)
    local now = tick()

    if AUTOFARM_SETTINGS.TP_FARM then
        runTPFarm(now)
    end
    if AUTOFARM_SETTINGS.TP_FARM_RANDOM then
        runTPFarmRandom(now)
    end
    if AUTOFARM_SETTINGS.SPIN_FARM then
        runSpinFarm(now, dt)
    end
    if AUTOFARM_SETTINGS.NEAREST_FARM then
        runNearestFarm(now)
    end
end)

