local function isAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(plr)
    if not CONFIG.TEAM_CHECK then return false end
    if not LocalPlayer.Team or not plr.Team then return false end
    return LocalPlayer.Team == plr.Team
end

local function isVisible(head, character)
    local origin = Camera.CFrame.Position
    local direction = (head.Position - origin)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rayParams.IgnoreWater = true
    local result = Workspace:Raycast(origin, direction, rayParams)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function findBestTarget(fov, useWallCheck)
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local camPos = Camera.CFrame.Position
    local candidates = {}
    local count = 0

    for _, plr in ipairs(Players:GetPlayers()) do
        if count >= PERF.MAX_TARGETS then break end
        if plr == LocalPlayer then continue end
        if not isAlive(plr) then continue end
        if isTeammate(plr) then continue end

        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if not head or not head:IsA("BasePart") then continue end

        local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
        local distFromCenter = (screenPos - center).Magnitude
        if distFromCenter > fov then continue end

        local worldDist = (head.Position - camPos).Magnitude
        local score = distFromCenter + worldDist * 0.05

        count = count + 1
        table.insert(candidates, { plr = plr, head = head, score = score, character = char })
    end

    table.sort(candidates, function(a, b) return a.score < b.score end)

    if not useWallCheck then
        if #candidates > 0 then
            local c = candidates[1]
            return c.plr, c.head, c.character
        end
        return nil, nil, nil
    end

    local checkedCount = math.min(#candidates, PERF.VISIBILITY_CHECKS)
    for i = 1, checkedCount do
        local c = candidates[i]
        if isVisible(c.head, c.character) then
            return c.plr, c.head, c.character
        end
    end
    return nil, nil, nil
end

local function getActiveMode()
    if triggering and MODULES.Trigger then
        return "Trigger", TRIGGER_CONFIG, true
    elseif MODULES.AimbotV2 then
        return "AimbotV2", AIMBOT_CONFIG.AimbotV2, false
    elseif MODULES.Aimbot then
        return "Aimbot", AIMBOT_CONFIG.Aimbot, false
    elseif MODULES.Aim and aiming then
        return "Aim", {
            FOV = CONFIG.FOV,
            SMOOTH_FACTOR = AIM.SMOOTH_FACTOR,
            DEADZONE_DEGREES = AIM.DEADZONE_DEGREES,
        }, false
    end
    return nil, nil, false
end

RunService.RenderStepped:Connect(function(dt)
    local mode, modeCfg, forceInstant = getActiveMode()

    if not mode then
        if currentTarget then
            currentTarget = nil
            cache.target = nil
            cache.head = nil
            cache.smoothedPosition = nil
            cache.smoothedVelocity = Vector3.zero
        end
        return
    end

    if mode == "Trigger" or mode == "AimbotV2" then
        cache.lastSearch = 0
        cache.lastTargetChange = 0
    end

    local now = tick()
    local needNewSearch = now - cache.lastSearch >= PERF.SEARCH_INTERVAL
    local targetLost = not cache.target or not cache.head or not cache.head.Parent
    local holdExpired = now - cache.lastTargetChange >= AIM.TARGET_HOLD_TIME
    local searchFov = modeCfg and modeCfg.FOV or CONFIG.FOV

    local useWallCheck = false
    if mode == "Aimbot" then useWallCheck = WALLCHECK.Aimbot end
    if mode == "AimbotV2" then useWallCheck = WALLCHECK.AimbotV2 end
    if mode == "Trigger" then useWallCheck = WALLCHECK.Trigger end
    if mode == "Aim" then useWallCheck = WALLCHECK.Aim end

    if mode == "Aimbot" then
        searchFov = FOV_SETTINGS.Aimbot
        modeCfg.FOV = searchFov
    elseif mode == "AimbotV2" then
        searchFov = FOV_SETTINGS.AimbotV2
        modeCfg.FOV = searchFov
    elseif mode == "Trigger" then
        searchFov = FOV_SETTINGS.Trigger
        modeCfg.FOV = searchFov
    elseif mode == "Aim" then
        searchFov = FOV_SETTINGS.Aim
    end

    if needNewSearch or targetLost then
        cache.lastSearch = now
        local newTarget, newHead, newChar = findBestTarget(searchFov, useWallCheck)

        if newTarget and (newTarget ~= cache.target) then
            local instantSwitch = (mode == "Trigger" or mode == "AimbotV2")
            if targetLost or holdExpired or instantSwitch then
                cache.target = newTarget
                cache.head = newHead
                cache.cachedCharacter = newChar
                cache.lastTargetChange = now
                cache.smoothedPosition = nil
                cache.smoothedVelocity = Vector3.zero
            end
        elseif newTarget and newTarget == cache.target then
            cache.head = newHead
            cache.cachedCharacter = newChar
        elseif not newTarget and targetLost then
            cache.target = nil
            cache.head = nil
            cache.smoothedPosition = nil
            cache.smoothedVelocity = Vector3.zero
        end
    end

    if not cache.target or not cache.head or not cache.head.Parent then
        currentTarget = nil
        return
    end

    local target = cache.target
    local head = cache.head

    if AIM.USE_PREDICTION then
        if now - cache.lastVelocityUpdate >= PERF.VELOCITY_INTERVAL then
            cache.lastVelocityUpdate = now
            local char = target.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            cache.cachedVelocity = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
        end
        cache.smoothedVelocity = cache.smoothedVelocity:Lerp(cache.cachedVelocity, AIM.PREDICTION_SMOOTH)
    else
        cache.smoothedVelocity = Vector3.zero
    end

    local rawTargetPos = head.Position + cache.smoothedVelocity * AIM.PREDICTION_STRENGTH
    rawTargetPos = rawTargetPos + Vector3.new(0, AIM.HEAD_OFFSET_Y, 0)

    if mode == "AimbotV2" or mode == "Trigger" then
        cache.smoothedPosition = rawTargetPos
    else
        if not cache.smoothedPosition then
            cache.smoothedPosition = rawTargetPos
        else
            cache.smoothedPosition = cache.smoothedPosition:Lerp(rawTargetPos, AIM.POSITION_SMOOTH)
        end
    end

    local targetPos
    if mode == "Trigger" then
        targetPos = head.Position + Vector3.new(0, AIM.HEAD_OFFSET_Y, 0)
        if AIM.USE_PREDICTION then
            targetPos = targetPos + cache.cachedVelocity * TRIGGER_CONFIG.PREDICTION_STRENGTH
        end
    elseif mode == "AimbotV2" then
        targetPos = head.Position + Vector3.new(0, AIM.HEAD_OFFSET_Y, 0)
        if AIM.USE_PREDICTION then
            targetPos = targetPos + cache.cachedVelocity * AIM.PREDICTION_STRENGTH
        end
    else
        targetPos = cache.smoothedPosition
    end

    local cameraPos = Camera.CFrame.Position
    local toTarget = targetPos - cameraPos
    local distance = toTarget.Magnitude
    if distance < 0.1 then return end

    if mode == "Trigger" or mode == "AimbotV2" or forceInstant then
        Camera.CFrame = CFrame.lookAt(cameraPos, targetPos)
    else
        local lookDirection = toTarget / distance
        local cameraDirection = Camera.CFrame.LookVector
        local dot = math.clamp(cameraDirection:Dot(lookDirection), -1, 1)
        local angleDeg = math.deg(math.acos(dot))

        local deadzone = modeCfg and modeCfg.DEADZONE_DEGREES or AIM.DEADZONE_DEGREES
        if angleDeg < deadzone then
            currentTarget = target
            return
        end

        local desiredCFrame = CFrame.lookAt(cameraPos, targetPos)
        local smoothFactor = modeCfg and modeCfg.SMOOTH_FACTOR or AIM.SMOOTH_FACTOR
        local smooth = 1 - math.pow(1 - smoothFactor, dt * 60)
        Camera.CFrame = Camera.CFrame:Lerp(desiredCFrame, smooth)
    end

    currentTarget = target
end)

