local function createGithubLogo(parent, size)
    local logo = Instance.new("Frame")
    logo.Name = "GithubLogo"
    logo.Size = UDim2.new(0, size, 0, size)
    logo.BackgroundTransparency = 1
    logo.Parent = parent

    local function circle(pos, sz)
        local f = Instance.new("Frame")
        f.Size = UDim2.new(sz, 0, sz, 0)
        f.Position = UDim2.new(pos.X, 0, pos.Y, 0)
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        f.BackgroundColor3 = THEME.WHITE
        f.BorderSizePixel = 0
        f.Parent = logo
        Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0)
        return f
    end

    local head = Instance.new("Frame")
    head.Size = UDim2.new(0.82, 0, 0.82, 0)
    head.Position = UDim2.new(0.5, 0, 0.55, 0)
    head.AnchorPoint = Vector2.new(0.5, 0.5)
    head.BackgroundColor3 = THEME.WHITE
    head.BorderSizePixel = 0
    head.Parent = logo
    Instance.new("UICorner", head).CornerRadius = UDim.new(1, 0)

    local earL = Instance.new("Frame")
    earL.Size = UDim2.new(0.26, 0, 0.26, 0)
    earL.Position = UDim2.new(0.27, 0, 0.16, 0)
    earL.AnchorPoint = Vector2.new(0.5, 0.5)
    earL.BackgroundColor3 = THEME.WHITE
    earL.BorderSizePixel = 0
    earL.Rotation = -22
    earL.Parent = logo
    Instance.new("UICorner", earL).CornerRadius = UDim.new(0.3, 0)

    local earR = Instance.new("Frame")
    earR.Size = UDim2.new(0.26, 0, 0.26, 0)
    earR.Position = UDim2.new(0.73, 0, 0.16, 0)
    earR.AnchorPoint = Vector2.new(0.5, 0.5)
    earR.BackgroundColor3 = THEME.WHITE
    earR.BorderSizePixel = 0
    earR.Rotation = 22
    earR.Parent = logo
    Instance.new("UICorner", earR).CornerRadius = UDim.new(0.3, 0)

    circle(Vector2.new(0.08, 0.82), 0.16)

    return logo
end

