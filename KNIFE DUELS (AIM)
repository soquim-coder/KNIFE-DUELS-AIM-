    earLCorner.Parent = earL

    -- Правое ухо
    local earR = Instance.new("Frame")
    earR.Size = UDim2.new(0.25, 0, 0.25, 0)
    earR.Position = UDim2.new(0.72, 0, 0.18, 0)
