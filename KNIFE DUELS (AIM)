    earR.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    earR.BorderSizePixel = 0
    earR.Rotation = 20
    earR.Parent = logo

    local earRCorner = Instance.new("UICorner")
    earRCorner.CornerRadius = UDim.new(0.3, 0)
    earRCorner.Parent = earR

    -- Хвост (маленький шарик слева-снизу)
    local tail = Instance.new("Frame")
    tail.Size = UDim2.new(0.18, 0, 0.18, 0)
    tail.Position = UDim2.new(0.08, 0, 0.82, 0)
