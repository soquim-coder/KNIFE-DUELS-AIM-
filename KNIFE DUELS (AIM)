-- =========================================
--           AIM ASSIST (PRECISE HEAD)
--           PERFORMANCE OPTIMIZED
-- =========================================
local aiming = false
local currentTarget = nil

local cache = {
    target = nil,
    head = nil,
    lastSearch = 0,
    lastVelocityUpdate = 0,
    cachedVelocity = Vector3.zero,
}

local function isAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(plr)
    if not CONFIG.TEAM_CHECK then return false end
    if not LocalPlayer.Team or not plr.Team then return false end
    return LocalPlayer.Team == plr.Team
end

local function isVisible(head, character)
    local origin = Camera.CFrame.Position
    local direction = (head.Position - origin)

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rayParams.IgnoreWater = true

    local result = Workspace:Raycast(origin, direction, rayParams)
    if not result then return true end
    return result.Instance:IsDescendantOf(character)
end

local function findBestTarget()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local fov = CONFIG.FOV
    local camPos = Camera.CFrame.Position

    local candidates = {}
    local count = 0

    for _, plr in ipairs(Players:GetPlayers()) do
        if count >= PERF.MAX_TARGETS then break end
        if plr == LocalPlayer then continue end
        if not isAlive(plr) then continue end
        if isTeammate(plr) then continue end

        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if not head or not head:IsA("BasePart") then continue end

        local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local screenPos = Vector2.new(screenPoint.X, screenPoint.Y)
        local distFromCenter = (screenPos - center).Magnitude
        if distFromCenter > fov then continue end

        local worldDist = (head.Position - camPos).Magnitude
        local score = distFromCenter + worldDist * 0.05

        count = count + 1
        table.insert(candidates, {
            plr = plr,
            head = head,
            score = score,
            character = char,
        })
    end

    table.sort(candidates, function(a, b)
        return a.score < b.score
    end)

    local checkedCount = math.min(#candidates, PERF.VISIBILITY_CHECKS)
    for i = 1, checkedCount do
        local c = candidates[i]
        if not CONFIG.WALL_CHECK then
            return c.plr, c.head
        end
        if isVisible(c.head, c.character) then
            return c.plr, c.head
        end
    end

    return nil, nil
end

RunService.RenderStepped:Connect(function(dt)
    if not aiming then
        if currentTarget then
            currentTarget = nil
            cache.target = nil
            cache.head = nil
        end
        return
    end

    local now = tick()

    -- Поиск цели
    if now - cache.lastSearch >= PERF.SEARCH_INTERVAL or not cache.target then
        cache.lastSearch = now
        local target, head = findBestTarget()
        cache.target = target
        cache.head = head
    end

    if not cache.target or not cache.head or not cache.head.Parent then
        cache.target = nil
        cache.head = nil
        currentTarget = nil
        return
    end

    local target = cache.target
    local head = cache.head

    -- Velocity (кэш)
    local velocity = Vector3.zero
    if AIM.USE_PREDICTION then
        if now - cache.lastVelocityUpdate >= PERF.VELOCITY_INTERVAL then
            cache.lastVelocityUpdate = now
            local char = target.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            cache.cachedVelocity = hrp and hrp.AssemblyLinearVelocity or Vector3.zero
        end
        velocity = cache.cachedVelocity
    end

    local targetPos = head.Position + velocity * AIM.PREDICTION_STRENGTH
    targetPos = targetPos + Vector3.new(0, AIM.HEAD_OFFSET_Y, 0)

    local cameraPos = Camera.CFrame.Position

    -- Deadzone через dot product
    local toTarget = targetPos - cameraPos
    local distance = toTarget.Magnitude
    if distance < 0.1 then return end

    local lookDirection = toTarget / distance
    local cameraDirection = Camera.CFrame.LookVector
    local dot = cameraDirection:Dot(lookDirection)

    if dot > AIM.DEADZONE_DOT then
        currentTarget = target
        return
    end

    if AIM.INSTANT then
        Camera.CFrame = CFrame.lookAt(cameraPos, targetPos)
    else
        local lookCFrame = CFrame.lookAt(cameraPos, targetPos)
        Camera.CFrame = Camera.CFrame:Lerp(lookCFrame, AIM.SMOOTH_LERP)
    end

    currentTarget = target
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CONFIG.AIM_KEY then
        aiming = true
        cache.lastSearch = 0
        cache.lastVelocityUpdate = 0
    end
end)

UserInputService.InputEnded:Connect(function(input, gameProcessed)
    if input.KeyCode == CONFIG.AIM_KEY then
        aiming = false
        currentTarget = nil
        cache.target = nil
        cache.head = nil
    end
end)

